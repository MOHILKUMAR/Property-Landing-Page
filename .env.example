# Copy this file to .env.local (git-ignored) and fill in real values.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# API key from https://resend.com/api-keys (server-side only, never prefix with VITE_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact requests are delivered (comma-separate multiple addresses)
CONTACT_TO_EMAIL=you@example.com

# Sender address. Must be on a domain verified in Resend.
# Without a verified domain, use onboarding@resend.dev; Resend then only
# delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL=MSr Real Estates <onboarding@resend.dev>
